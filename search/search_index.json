{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u4e3b\u9875","text":"Sail's Blog"},{"location":"about/","title":"\u5173\u4e8e","text":"<p>\u4f60\u597d\uff0c\u6211\u662f Sail\u3002</p> <p>\u8fd9\u91cc\u662f\u4e00\u6bb5\u81ea\u6211\u4ecb\u7ecd\u7684\u5360\u4f4d\u6587\u5b57\u3002\u4f60\u53ef\u4ee5\u5728\u4ee5\u540e\u8865\u5145\u81ea\u5df1\u7684\u5b66\u4e60\u7ecf\u5386\u3001\u6280\u672f\u65b9\u5411\u3001\u5174\u8da3\u7231\u597d\u548c\u8054\u7cfb\u65b9\u5f0f\u3002</p>"},{"location":"course/","title":"\u8bfe\u7a0b","text":"<p>\u8fd9\u91cc\u8bb0\u5f55\u6211\u7684\u5b66\u4e60\u7b14\u8bb0\u3001\u6280\u672f\u5b9e\u8df5\u548c\u8bfe\u7a0b\u603b\u7ed3\u3002</p>"},{"location":"course/#_2","title":"\u6587\u7ae0\u5217\u8868","text":"<ul> <li>\u793a\u4f8b\uff1a\u5982\u4f55\u5199\u4e00\u7bc7\u6280\u672f\u535a\u5ba2</li> </ul>"},{"location":"course/example/","title":"\u5982\u4f55\u5199\u4e00\u7bc7\u6280\u672f\u535a\u5ba2","text":"<p>\u8fd9\u662f\u4e00\u7bc7\u793a\u4f8b\u6587\u7ae0\u3002\u4ee5\u540e\u53ef\u4ee5\u590d\u5236\u8fd9\u4e2a\u6587\u4ef6\uff0c\u518d\u66ff\u6362\u6807\u9898\u548c\u5185\u5bb9\u3002</p>"},{"location":"course/example/#_2","title":"\u6587\u7ae0\u6458\u8981","text":"<p>\u7528\u4e24\u4e09\u53e5\u8bdd\u8bf4\u660e\u8fd9\u7bc7\u6587\u7ae0\u8981\u89e3\u51b3\u4ec0\u4e48\u95ee\u9898\u3001\u9002\u5408\u54ea\u4e9b\u8bfb\u8005\uff0c\u4ee5\u53ca\u8bfb\u5b8c\u540e\u80fd\u83b7\u5f97\u4ec0\u4e48\u3002</p>"},{"location":"course/example/#_3","title":"\u51c6\u5907\u5de5\u4f5c","text":"<p>\u5f00\u59cb\u524d\uff0c\u5efa\u8bae\u51c6\u5907\u597d\uff1a</p> <ul> <li>Python 3.10 \u6216\u66f4\u9ad8\u7248\u672c</li> <li>\u4e00\u4e2a\u6587\u672c\u7f16\u8f91\u5668</li> <li>\u57fa\u672c\u7684\u547d\u4ee4\u884c\u64cd\u4f5c\u7ecf\u9a8c</li> </ul>"},{"location":"course/example/#_4","title":"\u5b9e\u73b0\u6b65\u9aa4","text":""},{"location":"course/example/#1","title":"1. \u5b89\u88c5\u4f9d\u8d56","text":"<p>\u5148\u8fd0\u884c\u4e0b\u9762\u7684\u547d\u4ee4\uff1a</p> <pre><code>python -m pip install example-package\n</code></pre>"},{"location":"course/example/#2","title":"2. \u7f16\u5199\u4ee3\u7801","text":"<p>\u4ee3\u7801\u5757\u5e94\u8be5\u5c3d\u91cf\u5b8c\u6574\uff0c\u5e76\u5728\u524d\u540e\u89e3\u91ca\u5b83\u7684\u4f5c\u7528\uff1a</p> <pre><code>def greet(name: str) -&gt; str:\n    \"\"\"\u8fd4\u56de\u4e00\u53e5\u95ee\u5019\u8bed\u3002\"\"\"\n    return f\"Hello, {name}!\"\n\n\nprint(greet(\"Sail\"))\n</code></pre>"},{"location":"course/example/#3","title":"3. \u68c0\u67e5\u7ed3\u679c","text":"<p>\u8fd0\u884c\u4ee3\u7801\u540e\uff0c\u4f60\u5e94\u8be5\u770b\u5230\uff1a</p> <pre><code>Hello, Sail!\n</code></pre> <p>\u5199\u4f5c\u5efa\u8bae</p> <p>\u5982\u679c\u67d0\u4e00\u6b65\u5bb9\u6613\u51fa\u9519\uff0c\u53ef\u4ee5\u7528\u8fd9\u79cd\u63d0\u793a\u6846\u8bf4\u660e\u5e38\u89c1\u95ee\u9898\u548c\u89e3\u51b3\u65b9\u6cd5\u3002</p>"},{"location":"course/example/#_5","title":"\u603b\u7ed3","text":"<p>\u6587\u7ae0\u7ed3\u5c3e\u7528\u7b80\u77ed\u7684\u5217\u8868\u56de\u987e\u6838\u5fc3\u5185\u5bb9\uff1a</p> <ul> <li>\u8bf4\u660e\u4e86\u8981\u89e3\u51b3\u7684\u95ee\u9898</li> <li>\u7ed9\u51fa\u4e86\u53ef\u590d\u73b0\u7684\u64cd\u4f5c\u6b65\u9aa4</li> <li>\u63d0\u4f9b\u4e86\u4ee3\u7801\u3001\u7ed3\u679c\u548c\u6392\u9519\u63d0\u793a</li> </ul>"},{"location":"course/example/#_6","title":"\u53c2\u8003\u8d44\u6599","text":"<ul> <li>MkDocs \u5b98\u65b9\u6587\u6863</li> <li>Material for MkDocs \u6587\u6863</li> </ul>"},{"location":"friends/","title":"\u53cb\u94fe","text":"<p>\u8fd9\u91cc\u6536\u5f55\u4e00\u4e9b\u503c\u5f97\u5e38\u5e38\u8bbf\u95ee\u7684\u7f51\u7ad9\u3002</p> <ul> <li>\u597d\u53cb\u7684\u535a\u5ba2\uff08\u793a\u4f8b\uff09</li> <li>MkDocs \u5b98\u65b9\u7f51\u7ad9</li> </ul>"}]}